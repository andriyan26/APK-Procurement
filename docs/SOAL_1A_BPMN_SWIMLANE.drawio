        <!-- ============================================================ -->
        <mxCell id="act_pur_sourcing" value="Terima PR Approved &amp;&#xa;Pilih Rekanan Vendor Terdaftar&#xa;(Quick Auto-Fill Vendor Presets)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=1.5;fontColor=#3730A3;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="lane_purchasing">
          <mxGeometry x="35" y="710" width="210" height="65" as="geometry" />
        </mxCell>

        <mxCell id="act_pur_ai_quote" value="Pindai Surat Penawaran Vendor&#xa;via AI Quotation OCR Scanner&#xa;(Ekstrak Nama, Kontak &amp; Terms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=1.5;fontColor=#3730A3;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="lane_purchasing">
          <mxGeometry x="35" y="805" width="210" height="65" as="geometry" />
