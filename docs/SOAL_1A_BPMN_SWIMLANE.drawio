        </mxCell>

        <!-- SWIMLANE 1: REQUESTER (KOLOM VERTIKAL 1) -->
        <mxCell id="lane_requester" value="01. REQUESTER&#xa;(Divisi Pemohon Barang/Jasa)" style="swimlane;html=1;startSize=45;horizontal=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1E293B;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="pool_procurement">
