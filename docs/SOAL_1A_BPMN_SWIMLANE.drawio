        <!-- POOL UTAMA (VERTIKAL: JUDUL HORIZONTAL DI ATAS, KOLOM PANJANG KE BAWAH) -->
        <mxCell id="pool_procurement" value="SISTEM PENGADAAN BARANG &amp; JASA (PROCUREMENT LIFECYCLE) — SCOPE: REQUEST S/D FISIK GUDANG" style="swimlane;html=1;childLayout=stackLayout;startSize=45;horizontal=1;horizontalStack=1;resizeParent=1;resizeParentMax=0;fillColor=#1E3A8A;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;swimlaneLine=1;" vertex="1" parent="1">
