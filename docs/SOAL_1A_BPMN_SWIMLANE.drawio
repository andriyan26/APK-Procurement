  <diagram id="BPMN-Procurement-Vertical" name="BPMN Swimlane Procurement Lifecycle (Vertical)">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
