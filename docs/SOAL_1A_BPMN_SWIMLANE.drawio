        <!-- Flow 16: Scan AI -> Inspeksi Fisik Kuantitas & Kondisi -->
        <mxCell id="flow_16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" parent="1" source="act_wh_ai_scan" target="act_wh_inspect">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flow 17: Inspeksi Fisik -> Terbitkan & Cetak Berita Acara GR -->
        <mxCell id="flow_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" parent="1" source="act_wh_inspect" target="act_wh_gr_slip">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flow 18: Terbitkan GR -> Selesai / Barang Masuk Gudang -->
        <mxCell id="flow_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" parent="1" source="act_wh_gr_slip" target="end_success">
          <mxGeometry relative="1" as="geometry" />
