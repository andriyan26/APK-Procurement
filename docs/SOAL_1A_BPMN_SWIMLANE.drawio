        <mxCell id="gw_approval" value="Disetujui?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#92400E;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="lane_approver">
          <mxGeometry x="95" y="490" width="90" height="70" as="geometry" />
