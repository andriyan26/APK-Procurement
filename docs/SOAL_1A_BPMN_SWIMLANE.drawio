        <!-- Flow 6A: Gateway -> Tolak PR (Cabang Tidak) -->
        <mxCell id="flow_6_no" value="Tidak (Ditolak)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=2;fontColor=#DC2626;fontSize=10;fontStyle=1;" edge="1" parent="1" source="gw_approval" target="act_app_reject">
          <mxGeometry relative="1" as="geometry">
