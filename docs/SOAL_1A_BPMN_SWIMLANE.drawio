        <!-- Flow 1: Start -> AI Scanner -->
        <mxCell id="flow_1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;" edge="1" parent="1" source="start_req" target="act_req_ai">
