        <!-- JALUR DISETUJUI (APPROVE) -->
        <mxCell id="act_app_approve" value="Otorisasi &amp; Setujui PR&#xa;(Status Berubah: Approved)&#xa;&amp; Teruskan ke Bagian Purchasing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;fontColor=#065F46;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="lane_approver">
