              <mxPoint x="1300" y="1380" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Flow 15: Warehouse Tiba -> Scan AI Surat Jalan -->
        <mxCell id="flow_15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" parent="1" source="act_wh_arrive" target="act_wh_ai_scan">
          <mxGeometry relative="1" as="geometry" />
