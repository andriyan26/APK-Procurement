        <mxCell id="lbl_end_ok" value="Selesai: Barang Sampai&#xa;&amp; Diterima di Gudang&#xa;(Scope Selesai Sempurna)" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#065F46;fontStyle=1;" vertex="1" parent="lane_warehouse">
