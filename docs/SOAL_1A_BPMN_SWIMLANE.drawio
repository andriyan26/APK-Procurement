        <mxCell id="lbl_start" value="Mulai: Kebutuhan&#xa;Barang / Jasa Muncul" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#065F46;fontStyle=1;" vertex="1" parent="lane_requester">
