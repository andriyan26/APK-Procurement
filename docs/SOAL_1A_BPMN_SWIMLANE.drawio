        <!-- SWIMLANE 2: APPROVER (KOLOM VERTIKAL 2) -->
        <mxCell id="lane_approver" value="02. APPROVER&#xa;(Kepala Divisi / Dept Head)" style="swimlane;html=1;startSize=45;horizontal=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#1E293B;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="pool_procurement">
          <mxGeometry x="280" y="45" width="280" height="1815" as="geometry" />
        </mxCell>

        <!-- SWIMLANE 3: PURCHASING (KOLOM VERTIKAL 3) -->
        <mxCell id="lane_purchasing" value="03. PURCHASING&#xa;(Procurement &amp; Sourcing)" style="swimlane;html=1;startSize=45;horizontal=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1E293B;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="pool_procurement">
          <mxGeometry x="560" y="45" width="280" height="1815" as="geometry" />
        </mxCell>

        <!-- SWIMLANE 4: VENDOR (KOLOM VERTIKAL 4) -->
        <mxCell id="lane_vendor" value="04. VENDOR REKANAN&#xa;(Eksternal Supplier)" style="swimlane;html=1;startSize=45;horizontal=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#1E293B;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="pool_procurement">
