          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="390" y="560" />
              <mxPoint x="390" y="635" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Flow 7: Setujui PR -> Purchasing Sourcing (Pindah Kolom 2 ke Kolom 3) -->
        <mxCell id="flow_7" value="Notifikasi PR Approved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#059669;fontSize=10;fontStyle=1;" edge="1" parent="1" source="act_app_approve" target="act_pur_sourcing">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="390" y="735" />
              <mxPoint x="740" y="735" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Flow 8: Purchasing Sourcing -> AI Quotation Scan -->
        <mxCell id="flow_8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4F46E5;strokeWidth=2;" edge="1" parent="1" source="act_pur_sourcing" target="act_pur_ai_quote">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flow 9: AI Quotation Scan -> Atur Terms & Harga Deal -->
        <mxCell id="flow_9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4F46E5;strokeWidth=2;" edge="1" parent="1" source="act_pur_ai_quote" target="act_pur_create_po">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flow 10: Atur Terms -> Terbitkan & Cetak PO -->
        <mxCell id="flow_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4F46E5;strokeWidth=2;" edge="1" parent="1" source="act_pur_create_po" target="act_pur_issue_po">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flow 11: Terbitkan PO -> Vendor Terima PO (Pindah Kolom 3 ke Kolom 4) -->
