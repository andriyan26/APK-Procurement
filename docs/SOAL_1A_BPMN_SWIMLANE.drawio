          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flow 14: Kirim Armada -> Warehouse Terima Barang (Pindah Kolom 4 ke Kolom 5) -->
        <mxCell id="flow_14" value="Kirim Armada &amp; Surat Jalan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9333EA;strokeWidth=2;fontColor=#9333EA;fontSize=10;fontStyle=1;" edge="1" parent="1" source="act_ven_ship" target="act_wh_arrive">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
