        <mxCell id="lbl_end_rej" value="Selesai: PR Ditolak&#xa;(Revisi / Batal)" style="text;html=1;align=center;verticalAlign=top;fontSize=10;fontColor=#991B1B;fontStyle=1;" vertex="1" parent="lane_approver">
          <mxGeometry x="160" y="700" width="105" height="25" as="geometry" />
