        <mxCell id="act_pur_create_po" value="Atur Syarat Bayar (Net 30/COD),&#xa;Estimasi Tiba &amp; Negosiasi Harga Deal&#xa;(Live Recalculate Subtotal PO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=1.5;fontColor=#3730A3;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="lane_purchasing">
